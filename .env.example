# Copy to .env.local (scripts/setup-database.ps1 writes it for you)
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=baumb
DB_USER=baumb_app
DB_PASSWORD=change-me
# Set to "true" when the server has a trusted TLS certificate (e.g. Azure SQL)
DB_ENCRYPT=false

# AI food check and health chat (Anthropic Claude). Create a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional overrides
ANTHROPIC_MODEL=claude-sonnet-5-5
# low | medium | high — food lookups favour accuracy, chat favours speed
ANTHROPIC_FOOD_EFFORT=medium
ANTHROPIC_CHAT_EFFORT=low
# Concurrent AI calls per server process (extra requests wait in a bounded queue)
AI_MAX_CONCURRENCY=8
