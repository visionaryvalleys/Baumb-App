# Copy to .env.local (scripts/setup-database.ps1 writes it for you)
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=baumb
DB_USER=baumb_app
DB_PASSWORD=change-me
# Set to "true" when the server has a trusted TLS certificate (e.g. Azure SQL)
DB_ENCRYPT=false

# Food check and BAUMB Trainer chat. Set one key; when several are set the order is
# Gemini, OpenAI, Anthropic (override with AI_PROVIDER=gemini|openai|anthropic).
# Google Gemini (has a free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
# Anthropic Claude: https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# low | medium | high — food lookups favour accuracy, chat favours speed
AI_FOOD_EFFORT=medium
AI_CHAT_EFFORT=low
# Concurrent AI calls per server process (extra requests wait in a bounded queue)
AI_MAX_CONCURRENCY=8
